# Copy these into repo-root `.env` when using `npm run local:dev:up`.
# MySQL, Redis, and MinIO are all required.

NODE_ENV=development
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=mofi_local_root
DB_NAME=qshelter-dev

REDIS_PORT=6379

# Required MinIO (not optional for local dev)
CUSTOM_AWS_S3_BUCKET_NAME=mofi-local
CUSTOM_AWS_ACCESS_KEY_ID=minioadmin
CUSTOM_AWS_SECRET_ACCESS_KEY=minioadmin
CUSTOM_AWS_REGION=us-east-1
CUSTOM_AWS_ENDPOINT=http://127.0.0.1:9000
CUSTOM_AWS_FORCE_PATH_STYLE=true

PRESIGNED_URL_TTL=3600
JWT_SECRET=local-dev-secret
NOTIFICATION_URL=https://api.qshelter.ng/testnotify/email

AMQP_URL=amqp://mofi:mofi@127.0.0.1:5672/mofi