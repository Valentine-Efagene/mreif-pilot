# Copy these into repo-root `.env` (or CI env) when using `npm run local:test:up`.
# MySQL, Redis, and MinIO are all required.

NODE_ENV=test
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USERNAME=root
DB_PASSWORD=mofi_test_root
DB_NAME=mofi_platform_test

REDIS_PORT=6380

# Required MinIO (not optional for local test)
CUSTOM_AWS_S3_BUCKET_NAME=mofi-test
CUSTOM_AWS_ACCESS_KEY_ID=minioadmin
CUSTOM_AWS_SECRET_ACCESS_KEY=minioadmin
CUSTOM_AWS_REGION=us-east-1
CUSTOM_AWS_ENDPOINT=http://127.0.0.1:9100
CUSTOM_AWS_FORCE_PATH_STYLE=true

PRESIGNED_URL_TTL=3600
JWT_SECRET=local-test-secret
NOTIFICATION_URL=https://api.qshelter.ng/testnotify/email

AMQP_URL=amqp://mofi:mofi@127.0.0.1:5673/mofi
MESSAGING_ENABLED=false
NOTIFICATION_MODE=sync
LAMBDA_INVOKE_MODE=sync

# Optional integration tests against running API
# MOFI_PLATFORM_API_URL=http://127.0.0.1:8080
