{
  "name": "mofi-platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "MOFI Platform API — multicontainer Nest domain services",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "MOFI_CONTAINER_ROLE=edge nest start",
    "start:dev": "MOFI_CONTAINER_ROLE=edge PORT=8080 nest start --watch",
    "start:dev:developer": "MOFI_CONTAINER_ROLE=developer PORT=3004 npx ts-node -r tsconfig-paths/register domains/developer/src/main.ts",
    "start:prod": "MOFI_CONTAINER_ROLE=edge node dist/apps/edge/src/main.js",
    "start:edge": "MOFI_CONTAINER_ROLE=edge node dist/apps/edge/src/main.js",
    "start:worker": "MOFI_CONTAINER_ROLE=worker MESSAGING_ENABLED=true node dist/apps/worker/src/main.js",
    "auth:shadow": "node scripts/auth-shadow-compare.mjs",
    "lint": "eslint \"{apps,domains,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:contract": "jest --config contract-tests/jest.config.js",
    "cdk": "cd infra/aws && npx cdk",
    "cdk:deploy": "cd infra/aws && npx cdk deploy --all",
    "cdk:synth": "cd infra/aws && npx cdk synth",
    "local:dev:up": "docker compose -f infra/local/dev/docker-compose.yml -p mofi-platform-dev up -d",
    "local:dev:down": "docker compose -f infra/local/dev/docker-compose.yml -p mofi-platform-dev down",
    "local:test:up": "docker compose -f infra/local/test/docker-compose.yml -p mofi-platform-test up -d",
    "local:test:down": "docker compose -f infra/local/test/docker-compose.yml -p mofi-platform-test down",
    "k8s:setup": "bash infra/k8s/scripts/cluster-up.sh dev",
    "k8s:down": "bash infra/k8s/scripts/cluster-down.sh",
    "k8s:logs": "bash infra/k8s/scripts/logs-platform.sh",
    "k8s:test:setup": "bash infra/k8s/scripts/test-setup.sh",
    "k8s:refresh": "bash infra/k8s/scripts/refresh-platform.sh"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.609.0",
    "@aws-sdk/lib-storage": "^3.485.0",
    "@aws-sdk/s3-presigned-post": "^3.511.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@qshelter/nest-auth": "file:../qshelter-auth",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.9",
    "archiver": "^7.0.1",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "fuse.js": "^7.5.0",
    "graphql": "^16.9.0",
    "http-proxy-middleware": "^3.0.5",
    "jimp": "^0.22.10",
    "joi": "^17.13.3",
    "jwt-decode": "^4.0.0",
    "mime-types": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.14.5",
    "nestjs-paginate": "^9.1.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.26",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "aws-cdk": "^2.170.0",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}
