NODE_ENV=development
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=qshelter-dev

# Production / ECS: use real AWS S3 (no CUSTOM_AWS_ENDPOINT).
AWS_S3_BUCKET_NAME=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1

CUSTOM_AWS_S3_BUCKET_NAME=
CUSTOM_AWS_ACCESS_KEY_ID=
CUSTOM_AWS_SECRET_ACCESS_KEY=
CUSTOM_AWS_REGION=us-east-1

# --- Local Kubernetes (recommended): npm run k8s:setup — env from Helm ConfigMap, not this file ---

# --- Host monolith (npm run start:dev): use infra/local/dev/.env.example values for MinIO/RabbitMQ ---
#
# CUSTOM_AWS_ENDPOINT=http://127.0.0.1:9000
# CUSTOM_AWS_FORCE_PATH_STYLE=true
# (plus bucket + minioadmin credentials — see infra/local/README.md)

PRESIGNED_URL_TTL=3600
NOTIFICATION_URL=https://api.qshelter.ng/testnotify/email
JWT_SECRET=local-dev-secret

# RabbitMQ 3.13+ (see infra/local when using compose); docs/rabbitmq.md
AMQP_URL=amqp://mofi:mofi@127.0.0.1:5672/mofi
# Redeliveries before dead-letter (requires x-delivery-limit)
MOFI_RMQ_DELIVERY_LIMIT=5

# local = MofiAuthorizerGuard (dev without API Gateway); gateway = authorizer only (ECS/CDK default)
AUTH_ENFORCEMENT=local
