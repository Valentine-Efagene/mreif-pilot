{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "paths": {
      "@mofi/auth/*": ["libs/auth/src/*"],
      "@mofi/common/*": ["libs/common/src/*"],
      "@mofi/database/*": ["libs/database/src/*"],
      "@mofi/storage/*": ["libs/storage/src/*"]
    }
  },
  "include": ["apps/**/*", "domains/**/*", "libs/**/*", "system-tests/**/*"]
}
